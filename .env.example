# GoalQuest Environment Configuration

# LLM Provider Keys
GROQ_API_KEY=your_groq_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# HF_API_KEY=your_huggingface_api_key_here

# Model Selection (e.g. openai/gpt-oss-120b, qwen/qwen3.8-27b, claude-sonnet-5-5)
GQ_MODEL=openai/gpt-oss-120b

# Database & Storage
GQ_DATABASE_URL=sqlite:///./goalquest.db
# GQ_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/goalquest
GQ_REDIS_URL=redis://localhost:6379/0
GQ_CHROMA_PATH=./.chroma

# Game Mechanics Knobs
GQ_DAILY_XP_CAP=400
GQ_STREAK_FREEZE_EVERY_N_DAYS=7
GQ_MAX_TASKS_PER_DAY=3
